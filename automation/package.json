{
  "name": "nox-automacao-credpago",
  "private": true,
  "type": "module",
  "description": "Worker de automação da CredPago da NOX Fiança — roda separado do frontend (Vercel), hospedado na VPS.",
  "scripts": {
    "start": "tsx supervisor.ts",
    "start:credit": "tsx credpagoWorker.ts",
    "start:repair": "tsx repairWorker.ts",
    "validate": "tsx validateAutomation.ts",
    "start:once": "tsx credpagoWorker.ts --once",
    "backfill:names": "tsx backfillCreditCustomerNames.ts",
    "export-session": "tsx exportSession.ts",
    "login:interactive": "node interactiveLogin.mjs",
    "refresh-vps-session": "node refreshVpsSession.mjs",
    "copy-vps-command": "node copyVpsCommand.mjs",
    "install-browsers": "playwright install --with-deps chromium",
    "test": "tsx --test *.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "16.6.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

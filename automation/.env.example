# Copie este arquivo para automation/.env e preencha os valores.
# automation/.env é local e NUNCA deve ser commitado (contém a service role key).

# Mesma URL do projeto Supabase usado pelo frontend (confira contra VITE_SUPABASE_URL no .env da raiz).
SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Service role key — Settings > API no painel do Supabase. Só usar aqui, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Prazo máximo de cada operação da fila no Supabase.
SUPABASE_REQUEST_TIMEOUT_MS=15000

# Pasta do perfil persistente do Chrome (mantém o login da CredPago entre execuções).
# Só usado quando CREDPAGO_STORAGE_STATE_PATH (abaixo) estiver vazio — é o modo local/Windows.
CREDPAGO_PROFILE_DIR="./automation/chrome-profile-credpago"

# Caminho de um arquivo de sessão portátil (gerado por `npm run automation:export-session`).
# Defina isto na VPS/produção; deixe vazio no seu ambiente local (usa o perfil acima).
# CREDPAGO_STORAGE_STATE_PATH="/app/data/credpago-session.json"

# Porta do servidor HTTP só com GET /health (monitoramento/Docker healthcheck).
HEALTH_PORT=3000

# Processo independente de auto-recuperacao e sua rota de health local.
REPAIR_HEALTH_PORT=3001
REPAIR_POLL_INTERVAL_MS=3000
REPAIR_VALIDATION_TIMEOUT_MS=60000
REPAIR_AUTO_ENABLED=true
# Protege GET /details; GET /health expoe somente status minimo sanitizado.
REPAIR_HEALTH_TOKEN=""
AUTOMATION_ENVIRONMENT=production
AUTOMATION_VERSION=unknown
DEPLOY_VERSION=unknown
VPS_ID=""
AUTOMATION_LOCK_PATH="/app/data/credit-automation.lock"
ERROR_SPOOL_DIR="/app/data/error-spool"
REPAIR_ARTIFACT_DIR="/app/data/repair-artifacts"
VPS_HIGH_CPU_PERCENT=90
VPS_HIGH_MEMORY_PERCENT=90
VPS_LOW_DISK_USED_PERCENT=90

# Intervalo (ms) entre verificações de novas consultas pendentes.
AUTOMATION_POLL_INTERVAL_MS=5000

# URL atual da tela de análise de crédito usada pelo worker.
CREDPAGO_URL="https://app.loft.com.br/erp/proposta/analise-de-credito"

# Conta da imobiliária usada exclusivamente pelo worker da VPS para renovar a
# sessão quando o Login Loft expirar. Configure as duas juntas somente no
# automation/.env do servidor; nunca use variáveis VITE_ ou EXPO_PUBLIC_.
CREDPAGO_LOGIN=""
CREDPAGO_PASSWORD=""

# Cancelamento de propostas pela API oficial da Loft. Solicite as credenciais
# Client Credentials no canal da parceria e mantenha-as somente na VPS.
# A automação fica DESATIVADA enquanto estas credenciais e um motivo verdadeiro
# não forem configurados. Não alterne motivos: cada valor deve refletir o caso real.
LOFT_API_BASE_URL="https://api.loft.com.br"
LOFT_OAUTH_TOKEN_URL="https://auth.loft.com.br/v2/oauth/token"
LOFT_OAUTH_CLIENT_ID=""
LOFT_OAUTH_CLIENT_SECRET=""
LOFT_OAUTH_SCOPE="loft-aluguel"
# Opcional, quando a Loft fornecer um grant_id para agir em nome da imobiliária:
# LOFT_OAUTH_AUTHORIZATION_DETAILS='[{"type":"urn:loft:grant-delegation","grant_id":"UUID-FORNECIDO-PELA-LOFT"}]'

# Escolha somente UM motivo homologado e verdadeiro para este fluxo:
# Inquilino desistiu do aluguel
# Inquilino vai contratar outra fiança
# Inquilino vai usar outro tipo de garantia
# Imóvel não está mais disponível
LOFT_CANCELLATION_REASON=""
LOFT_CANCELLATION_COMMENT=""
LOFT_CANCELLATION_DELAY_MS=1800000
LOFT_CANCELLATION_REQUEST_TIMEOUT_MS=15000

# Valida e aquece a sessão antes de retirar consultas da fila (padrão: 4 min).
AUTH_CHECK_INTERVAL_MS=240000

# Se o Login Loft estiver temporariamente indisponível, mantém as consultas na
# fila e tenta recuperar a autenticação novamente após este intervalo.
AUTH_RETRY_INTERVAL_MS=60000

# Tempo máximo para o redirecionamento e confirmação do Login Loft.
# Este é o prazo TOTAL de todas as tentativas, não um prazo repetido por seletor.
AUTH_LOGIN_TIMEOUT_MS=75000

# Watchdog externo: se o portal/Playwright não encerrar a validação neste prazo,
# a aba é abortada e o navegador é recuperado automaticamente.
AUTH_VALIDATION_TIMEOUT_MS=90000

# Recria o navegador depois desta quantidade de falhas consecutivas de autenticação.
AUTH_FAILURES_BEFORE_BROWSER_RESTART=2

# Se "true", mantém o Chrome aberto após processar (útil para depurar seletores).
AUTOMATION_KEEP_BROWSER_OPEN=false

# O portal compartilha o estado da análise dentro da sessão autenticada. Por isso,
# o worker processa uma consulta por vez e mantém as excedentes na fila do Supabase.
# Valores maiores são reduzidos automaticamente para 1 pelo código.
MAX_CONCURRENT_CONSULTAS=1

# Tempo máximo (ms) para UMA consulta antes de ser marcada como erro (não trava as outras).
CONSULTA_TIMEOUT_MS=420000

# Consulta deixada como "processando" por queda do worker volta automaticamente
# para a fila depois deste prazo. Deve ser maior que CONSULTA_TIMEOUT_MS.
# A varredura é repetida a cada 60 segundos.
STALE_CONSULTA_MS=600000
STALE_RECOVERY_INTERVAL_MS=60000

# Chrome invisível. Requer que o perfil já esteja logado (login manual precisa de janela
# visível) — rode uma vez com HEADLESS=false para logar antes de ativar isto em produção.
HEADLESS=false
